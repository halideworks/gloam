# Visual Studio / C#
.vs/
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
*_wpftmp.csproj

# Build Output
publish/
publish-minimal/
publish-small/
dist/
dist-minimal/

# Logs (runtime-generated by the app and local build tooling)
startup_log.txt
crash_log.txt
BuildLog.txt
build_log.txt
*.log

# Editor / tool-local state
.claude/
.dotnet-home/
.vscode/
.idea/
*.bak

# Stray artifact: a `2>nul` redirect run in bash on Windows creates a literal
# file called "nul" because bash doesn't honor Windows reserved device names.
/nul

# OS Generated
Thumbs.db
Desktop.ini
.DS_Store

# Local marketing assets (before/after demo LUTs, scratch renders) - not shipped
marketing-assets/

# Packaging Artifacts
argyll_cache/
argyll_cache.zip
argyll_cache_*/
argyll_cache_*.zip
Gloam_*.zip
Releases/
ReleasesNew/
*.csv
*.cal

# Golden-sample regression fixtures are REAL measurement recordings the CI replay
# tests depend on — they must ship in the repo despite the blanket *.csv ignore.
!tests/Gloam.Tests/Fixtures/**/*.csv

# Internal planning document. Kept locally, deliberately not published: it carries
# competitive positioning, candid not-yet-validated notes, and unreleased plans that
# should not be the first thing a visitor browses.
ROADMAP.md

# Wrangler's local cache, written by any `wrangler pages deploy` run. Deploys
# are normally CI's job (.github/workflows/deploy-site.yml); this only appears
# when someone deploys the site by hand.
.wrangler/

# Build-time tooling only (KaTeX, used by scripts/build-whitepaper-math.mjs).
# The site itself ships no runtime JavaScript beyond its small inline scripts.
node_modules/
