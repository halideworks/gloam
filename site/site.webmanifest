{
  "name": "Gloam",
  "short_name": "Gloam",
  "description": "Free, open-source Windows display tool for SDR-in-HDR gamma, night mode, and measured calibration.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#000000",
